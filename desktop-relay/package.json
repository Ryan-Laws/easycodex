{
  "name": "easycodex-desktop-relay",
  "version": "0.1.7",
  "description": "Cross-platform desktop relay launcher for EasyCodex",
  "author": "EasyCodex Team",
  "homepage": "https://github.com/Ryan-Laws/easycodex",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "prepack": "npm run build:renderer && npm run prepare:relay-bundle",
    "predist": "npm run build:renderer && npm run prepare:relay-bundle",
    "predist:win": "npm run build:renderer && npm run prepare:relay-bundle",
    "predist:mac": "npm run build:renderer && npm run prepare:relay-bundle",
    "predist:linux": "npm run build:renderer && npm run prepare:relay-bundle",
    "start": "electron .",
    "dev": "electron .",
    "dev:renderer": "vite --config vite.config.mjs",
    "build:renderer": "vite build --config vite.config.mjs",
    "build:relay": "npm --prefix ../agent-relay run build",
    "test": "node --test test/*.test.cjs",
    "prepare:relay-bundle": "node scripts/prepare-relay-bundle.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "dist:linux": "electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "@preact/signals": "^2.9.0",
    "preact": "^10.29.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "rcedit": "^5.0.1",
    "vite": "^8.0.13"
  },
  "build": {
    "appId": "dev.easycodex.desktop-relay",
    "productName": "EasyCodex Relay",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "files": [
      "src/**/*",
      "!src/renderer/index.html",
      "!src/renderer/renderer.js",
      "!src/renderer/styles.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": ".relay-bundle",
        "to": "agent-relay",
        "filter": [
          "package.json",
          "dist/cli-helpers.js",
          "dist/codex-rpc.js",
          "dist/git-paths.js",
          "dist/notifier.js",
          "dist/permission-modes.js",
          "dist/safety-limits.js",
          "dist/server.js",
          "dist/session-orchestrator.js",
          "dist/updater.js"
        ]
      },
      {
        "from": ".relay-bundle/node_modules",
        "to": "agent-relay/node_modules",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.md",
          "!**/test{,s}/**/*",
          "!**/__test{,s}__/**/*",
          "!**/example{,s}/**/*",
          "!**/CHANGELOG*",
          "!**/README*",
          "!**/readme*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "EasyCodex.Relay.Setup.${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "zh_TW"
      ],
      "multiLanguageInstaller": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "EasyCodex Relay",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "EasyCodex.Relay.Portable.${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "EasyCodex.Relay.${version}.mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "icon": "src/assets/icon.png",
      "artifactName": "EasyCodex.Relay.${version}.linux-x64.${ext}",
      "category": "Development",
      "maintainer": "Ryan-Laws <Ryan-Laws@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
